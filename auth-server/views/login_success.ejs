<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Success - MemoryBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=VT323&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="scanlines"></div>
    <div class="container">
        <img src="/logo.png" alt="MemoryBank" class="logo">
        <h1>SUCCESS!</h1>
        <div class="subtitle">
            <%= message %>
        </div>

        <div class="links">
            <!-- Start a test flow for the default client -->
            <a
                href="/auth?client_id=mcp_client&response_type=code&scope=openid%20memories:read%20memories:write&redirect_uri=https://oauth.pstmn.io/v1/callback">Return
                to Login</a>
        </div>
    </div>
</body>

</html>