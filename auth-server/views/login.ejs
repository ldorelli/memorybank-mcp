<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - MemoryBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=VT323&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="scanlines"></div>
    <div class="container">
        <img src="/logo.png" alt="MemoryBank" class="logo">
        <h1>ACCESS VAULT</h1>
        <div class="subtitle">Authenticate to continue</div>

        <!-- Debugging: <%= JSON.stringify(params) %> -->

        <% if (flash) { %>
            <div class="flash-error">
                <%- flash %>
            </div>
            <% } %>

                <form autocomplete="off" action="/interaction/<%= uid %>/login" method="post">
                    <div class="input-group">
                        <label for="login">ACCESS ID</label>
                        <input required type="email" name="login" id="login" placeholder="user@memory.bank" autofocus>
                    </div>

                    <div class="input-group">
                        <label for="password">KEYCODE</label>
                        <input required type="password" name="password" id="password" placeholder="••••••••">
                    </div>

                    <button type="submit">UNLOCK</button>

                    <div class="links">
                        NO ACCOUNT? <a href="/interaction/<%= uid %>/signup">INITIALIZE HERE</a>
                    </div>
                </form>
    </div>
</body>

</html>