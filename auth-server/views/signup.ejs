<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign Up - MemoryBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=VT323&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="scanlines"></div>
    <div class="container">
        <img src="/logo.png" alt="MemoryBank" class="logo">
        <h1>NEW ACCOUNT</h1>
        <div class="subtitle">Create your memory vault</div>

        <% if (flash) { %>
            <div class="flash-error">
                <%= flash %>
            </div>
            <% } %>

                <form autocomplete="off" action="<%= uid ? `/interaction/${uid}/signup` : '/signup' %>" method="post">
                    <div class="input-group">
                        <label for="email">EMAIL ACCESS ID</label>
                        <input required type="email" name="email" id="email" placeholder="user@memory.bank" autofocus>
                    </div>

                    <div class="input-group">
                        <label for="password">SECRET KEYCODE</label>
                        <input required type="password" name="password" id="password" placeholder="••••••••">
                    </div>

                    <button type="submit" class="login-button">INITIALIZE</button>
                </form>

                <div class="links">
                    ALREADY HAVE A VAULT?
                    <% if (uid) { %>
                        <a href="/interaction/<%= uid %>">LOGIN HERE</a>
                        <% } else { %>
                            <!-- Need a way to get to login. Usually starts OIDC flow? -->
                            <!-- For standalone, maybe just direct to a login page if one exists, but login requires interaction usually -->
                            <!-- We can link to the standard auth start point if we knew it, or just back to home -->
                            <a href="/interaction/login">LOGIN HERE</a>
                            <% } %>
                </div>
    </div>
</body>

</html>